# Copiar a .env.local y rellenar (no subir secretos a git)

# Opcional — Convención Científica 2026 (resúmenes y comentarios)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional — Panel de administración de la convención
# ADMIN_PASSWORD=tu_contraseña_aqui

# Opcional — Notificaciones por Telegram (nuevos resúmenes)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789

# Opcional — Recuperación de fragmentos de libros de texto (RAG). Solo servidor: NUNCA con prefijo VITE_.
# 1) Ejecuta supabase/rag_schema.sql  2) node rag/embed.mjs  (ver docs/research/retrieval-design.md)
# AZURE_OPENAI_EMBED_ENDPOINT=https://<recurso>.openai.azure.com/openai/deployments/<deployment>/embeddings?api-version=2024-10-21
# AZURE_OPENAI_EMBED_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# RAG_MIN_SIMILARITY=0.50     # umbral coseno; por debajo no se usa el fragmento
# RAG_ENABLED=false           # desactiva la recuperación sin borrar nada
